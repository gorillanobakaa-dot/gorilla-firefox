+  .label = Search All Gorilla Tabs
 
 all-tabs-menu-new-user-context =
-  .label = New Container Tab
+  .label = New Gorilla Container Gorilla Tab
 
 all-tabs-menu-hidden-tabs =
-  .label = Hidden tabs
