# Gorilla 160 rebase: browser/locales/en-US/browser/allTabsMenu.ftl as built on Firefox 160
# The earlier patches of this file do not apply to pristine 160 (superseded in the policy with
# exclude_reason_160); this patch carries the file from the remaining set to the built tree.

diff --git a/browser/locales/en-US/browser/allTabsMenu.ftl b/browser/locales/en-US/browser/allTabsMenu.ftl
index 78b159bb6a67bd0360dd72063fd048865b24add8..a33662526769d28314fbd1dde85fbad5416654ce 100644
--- a/browser/locales/en-US/browser/allTabsMenu.ftl
+++ b/browser/locales/en-US/browser/allTabsMenu.ftl
@@ -4,23 +4,23 @@
 
