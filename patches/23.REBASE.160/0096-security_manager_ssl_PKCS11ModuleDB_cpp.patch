@@ -292,6 +292,13 @@ nsresult PKCS11ModuleDB::DoAddModule(const nsCString& moduleName,
                                      const nsCString& libraryPath,
                                      uint32_t mechanismFlags,
                                      uint32_t cipherFlags) {
+  // GORILLA UNLEASHED - PHYSICAL LOCK: no PKCS#11 module is loaded (D-158-18, owner 2026-10-15). A module is a
