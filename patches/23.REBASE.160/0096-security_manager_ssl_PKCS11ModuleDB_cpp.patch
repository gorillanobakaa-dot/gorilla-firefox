diff --git a/security/manager/ssl/PKCS11ModuleDB.cpp b/security/manager/ssl/PKCS11ModuleDB.cpp
index 3ec21265d06064a7e5cdab95a0742cc496e7b274..9d8be413d63325ee0768980d34fe9eb88856c531 100644
