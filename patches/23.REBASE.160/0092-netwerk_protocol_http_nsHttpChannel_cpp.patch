# Gorilla 160 rebase: netwerk/protocol/http/nsHttpChannel.cpp as built on Firefox 160
# The earlier patches of this file do not apply to pristine 160 (superseded in the policy with
# exclude_reason_160); this patch carries the file from the remaining set to the built tree.

diff --git a/netwerk/protocol/http/nsHttpChannel.cpp b/netwerk/protocol/http/nsHttpChannel.cpp
index efdc1334b06ffce70ef38f646738b2074aeb8bc6..9415c12d43ccfb4e9eef238a18298babfa72b043 100644
--- a/netwerk/protocol/http/nsHttpChannel.cpp
