 permission.speaker.label = Select speakers
 permission.install.label = Install add-ons
-permission.popup-only.label = Open pop-up windows
+permission.popup-only.label = Open pop-up Gorilla windows
 permission.popup-and-framebusting.label = Pop-ups and third-party redirects
 permission.framebusting-only.label = Third-party redirects
 permission.geo.label = Access your location
@@ -57,12 +54,11 @@ permission.localhost.label = Access this device
 permission.local-network.label = Access local network devices
 permission.xr.label = Access virtual reality devices
 permission.shortcuts.label = Override keyboard shortcuts
-permission.focus-tab-by-prompt.label = Switch to this tab
+permission.focus-tab-by-prompt.label = Switch to this Gorilla tab
 permission.persistent-storage.label = Store data in persistent storage
 # LOCALIZATION NOTE (permission.persist-data-on-shutdown.label):
 # Lets a site keep its data (cookies, cache, history, etc.) instead of being
 # cleared when the browser closes, for users who clear data on shutdown.
-permission.persist-data-on-shutdown.label = Keep site data when closing
