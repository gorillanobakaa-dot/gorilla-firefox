# Gorilla 160 rebase: toolkit/themes/shared/global-shared.css as built on Firefox 160
# The earlier patches of this file do not apply to pristine 160 (superseded in the policy with
# exclude_reason_160); this patch carries the file from the remaining set to the built tree.

diff --git a/toolkit/themes/shared/global-shared.css b/toolkit/themes/shared/global-shared.css
index 29cbb2d69f9338c63dbb97ea86ce7c05a25a7b78..993a2b7271e0a7f7f373963f13a47e08b7c5f0b3 100644
--- a/toolkit/themes/shared/global-shared.css
+++ b/toolkit/themes/shared/global-shared.css
@@ -14,9 +14,37 @@
 
 @import url("close-icon.css");
 
+/* GORILLA OVERRIDE: theme delivery for chrome://global/skin widgets (input
+   fields, dropdowns, text controls). MUST stay in this leading @import block:
+   an @import after any style rule is silently dropped by the CSS parser, which
+   is exactly how this was broken for weeks (it sat at the end of the file). The
+   URL is browser/skin because that is where master-redirect.css is registered
+   (browser/themes/shared/jar.inc.mn); there is no global/skin registration.
+   Guarded by patches/lint/check_css_import_position.py. */
+@import url("chrome://browser/skin/master-redirect.css");
+
 @namespace xul url("http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul");
 @namespace html url("http://www.w3.org/1999/xhtml");
 
+/* GORILLA OVERRIDE: restore FF154's upstream hidden-element safety net (vanilla
+   toolkit/themes/shared/global-shared.css:118) — anything carrying the `hidden`
+   attribute must not render; `:where()` keeps it at zero specificity so a
+   deliberate `!important` show-rule can still win. The pre-154 master template
+   this file derives from predates the rule; found missing 2026-08-03. */
+:where([hidden]) {
+  display: none !important;
+}
+
+/* GORILLA D-158-22 (owner 2026-10-23): "let's get rid of 'learn more' or any links to mozilla in the build". The older
+   "Learn more" anchors (class learnMore, data-l10n-name learn-more) and any link a page hard-codes to a Mozilla
+   site never show. moz-support-link hides itself (moz-support-link.mjs); the link prefs are "" and locked. */
+html|a.learnMore, html|a[data-l10n-name="learn-more"], html|a[data-l10n-name="learnMore"],
+html|a[href*="mozilla.org"], html|a[href*="mozilla.com"], html|a[href*="mozilla.net"], html|a[href*="firefox.com"],
+xul|label.text-link[href*="mozilla.org"], xul|label.text-link[href*="firefox.com"],
+xul|label[is="text-link"][href*="mozilla.org"], xul|label[is="text-link"][href*="firefox.com"] {
+  display: none !important;
+}
+
 :root {
