# Generated by working scripts/add_builtin_extension.py - do not hand-edit.
#
# NOTE THE DIRECTORY. This packages to gorilla-addons/, NOT to
# builtin-addons/, and that is load-bearing.
#
# toolkit/mozapps/extensions/gen_built_in_addons.py globs
#   builtin-addons/*/manifest.json
# and writes every match into built_in_addons.json. Everything in that
# file is loaded into the `app-builtin-addons` location, whose class in
# XPIProvider.sys.mjs hard-codes `get hidden() { return true; }`.
#
# So an extension placed under builtin-addons/ RUNS but can never be
# seen in about:addons and has no toolbar button - which was exactly
# the first attempt, and it is useless for anything a user configures.
# Using our own resource root keeps the generator from claiming it, so
# maybeInstallBuiltinAddon() can put it in the VISIBLE location.

browser.jar:
%   resource gorilla-addons %gorilla-addons/  contentaccessible=yes
    gorilla-addons/ublock-origin/1p-filters.html (1p-filters.html)
    gorilla-addons/ublock-origin/3p-filters.html (3p-filters.html)
    gorilla-addons/ublock-origin/LICENSE.txt (LICENSE.txt)
    gorilla-addons/ublock-origin/about.html (about.html)
    gorilla-addons/ublock-origin/advanced-settings.html (advanced-settings.html)
    gorilla-addons/ublock-origin/asset-viewer.html (asset-viewer.html)
    gorilla-addons/ublock-origin/background.html (background.html)
    gorilla-addons/ublock-origin/blank.html (blank.html)
    gorilla-addons/ublock-origin/cloud-ui.html (cloud-ui.html)
    gorilla-addons/ublock-origin/code-viewer.html (code-viewer.html)
    gorilla-addons/ublock-origin/dashboard.html (dashboard.html)
    gorilla-addons/ublock-origin/devtools.html (devtools.html)
    gorilla-addons/ublock-origin/document-blocked.html (document-blocked.html)
    gorilla-addons/ublock-origin/dyna-rules.html (dyna-rules.html)
    gorilla-addons/ublock-origin/logger-ui.html (logger-ui.html)
    gorilla-addons/ublock-origin/managed_storage.json (managed_storage.json)
    gorilla-addons/ublock-origin/manifest.json (manifest.json)
    gorilla-addons/ublock-origin/mozilla-recommendation.json (mozilla-recommendation.json)
    gorilla-addons/ublock-origin/no-dashboard.html (no-dashboard.html)
    gorilla-addons/ublock-origin/popup-fenix.html (popup-fenix.html)
    gorilla-addons/ublock-origin/settings.html (settings.html)
    gorilla-addons/ublock-origin/support.html (support.html)
    gorilla-addons/ublock-origin/whitelist.html (whitelist.html)
    gorilla-addons/ublock-origin/_locales/ (_locales/**)
    gorilla-addons/ublock-origin/assets/ (assets/**)
    gorilla-addons/ublock-origin/css/ (css/**)
    gorilla-addons/ublock-origin/img/ (img/**)
    gorilla-addons/ublock-origin/js/ (js/**)
    gorilla-addons/ublock-origin/lib/ (lib/**)
    gorilla-addons/ublock-origin/web_accessible_resources/ (web_accessible_resources/**)
