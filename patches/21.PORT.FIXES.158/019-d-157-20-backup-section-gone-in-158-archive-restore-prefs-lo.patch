# Gorilla 158 port fix
# D-157-20: Backup section gone in 158 (archive/restore prefs locked off, group removed from Settings)
# Files: browser/app/profile/firefox.js, browser/components/preferences/preferences.js

diff --git a/browser/app/profile/firefox.js b/browser/app/profile/firefox.js
index 4f99a5029c..c6b3aa8c69 100644
--- a/browser/app/profile/firefox.js
+++ b/browser/app/profile/firefox.js
@@ -3728,8 +3728,10 @@ pref("browser.backup.enabled", false, locked);
 pref("browser.backup.scheduled.enabled", false, locked);
 
 // Prefs to control visibility and usability of the create backup and restore from backup features.
-pref("browser.backup.archive.enabled", true);
-pref("browser.backup.restore.enabled", true);
+// GORILLA D-157-20 (2026-10-15): 158 shows the Backup section and its "Turn on backup" / "Restore your data" from these
+// two, not from browser.backup.enabled (locked off above, yet the section still showed: owner's screenshot 18:44)
+pref("browser.backup.archive.enabled", false, locked);
+pref("browser.backup.restore.enabled", false, locked);
 
 // The number of SQLite database pages to backup per step.
 pref("browser.backup.sqlite.pages_per_step", 50);
diff --git a/browser/components/preferences/preferences.js b/browser/components/preferences/preferences.js
index c3feceac53..b98cffd5e5 100644
--- a/browser/components/preferences/preferences.js
+++ b/browser/components/preferences/preferences.js
@@ -454,7 +454,7 @@ const CONFIG_PANES = Object.freeze({
       "sync",
       "importBrowserData",
       "profiles",
-      "backup",
+      // GORILLA D-157-20 (2026-10-15): "backup" removed; no backup feature (its default folder is OneDrive)
       "referrals",
     ],
     module: "chrome://browser/content/preferences/config/account-sync.mjs",
