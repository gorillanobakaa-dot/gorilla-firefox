index 6effd77609..1bd96dfafc 100644
--- a/browser/base/content/aboutDialog.xhtml
+++ b/browser/base/content/aboutDialog.xhtml
@@ -49,6 +49,7 @@
         <!-- This HBOX is duplicated below with class="update" -->
         <hbox align="baseline">
           <label id="version"/>
+          <label id="gorilla-buildid" class="text-blurb" hidden="true"/>
           <label id="releasenotes" is="text-link" hidden="true" data-l10n-id="releaseNotes-link"/>
         </hbox>
 #endif
diff --git a/browser/branding/gorilla/pref/firefox-branding.js b/browser/branding/gorilla/pref/firefox-branding.js
index 8c95ebf608..e44577eb6c 100644
--- a/browser/branding/gorilla/pref/firefox-branding.js
+++ b/browser/branding/gorilla/pref/firefox-branding.js
@@ -33,3 +33,6 @@ pref("app.update.badgeWaitTime", 0);
 // into the console is held behind the "Scam Warning" until the user types "allow pasting" once, or has typed five
 // commands; the console then counts itself up to 5. Not locked: the console must be able to raise it.
 pref("devtools.selfxss.count", 0);
+
+// GORILLA D-157-38 part 2 (2026-10-09): the build number Help > About shows ("build N"); raised once per release candidate.
+pref("gorilla.build.number", 1);
diff --git a/browser/locales/en-US/browser/aboutDialog.ftl b/browser/locales/en-US/browser/aboutDialog.ftl
index cddecd5dd7..c06e7e9254 100644
--- a/browser/locales/en-US/browser/aboutDialog.ftl
+++ b/browser/locales/en-US/browser/aboutDialog.ftl
@@ -93,10 +93,11 @@ aboutDialog-version = { $version } ({ $bits }-bit)
 ## Variables:
 ##   $built (String): when this build was made, YY:MM:DD:HH:MM:SS, e.g. 26:10:08:10:37:25
 
-aboutDialog-version-gorilla = { $version } ({ $bits }-bit) built { $built }
-aboutDialog-version-nightly-gorilla = { $version } ({ $isodate }) ({ $bits }-bit) built { $built }
-aboutdialog-version-arch-gorilla = { $version } ({ $arch }) built { $built }
-aboutdialog-version-arch-nightly-gorilla = { $version } ({ $isodate }) ({ $arch }) built { $built }
+aboutDialog-version-gorilla = { $version } ({ $bits }-bit) build { $build }, built { $built }
+aboutDialog-buildid-gorilla = Build ID { $buildid }
+aboutDialog-version-nightly-gorilla = { $version } ({ $isodate }) ({ $bits }-bit) build { $build }, built { $built }
+aboutdialog-version-arch-gorilla = { $version } ({ $arch }) build { $build }, built { $built }
+aboutdialog-version-arch-nightly-gorilla = { $version } ({ $isodate }) ({ $arch }) build { $build }, built { $built }
 
