# Gorilla 158 port fix
# D-157-38 part 2 on 158 (Help > About: '158.0 (64-bit) build 1, built YY:MM:DD:HH:MM:SS' and under it 'Build ID <14 digits>'). Made by Fable on Windows 2026-10-09 and never exported to the shared patch set; rebuilt from the register's checks and the harness's build-stamp probe, applied by fieldkit.buildh.buildstamp.apply_source(tree, number), which now holds the code and the places. Build number 1: the first Linux 158 candidate. lesson: a decision whose source change lives only in one machine's tree is not portable; its change must exist as harness code (apply_source) or as a patch in the shared set
# Files: browser/base/content/aboutDialog.js, browser/base/content/aboutDialog.xhtml, browser/branding/gorilla/pref/firefox-branding.js, browser/locales/en-US/browser/aboutDialog.ftl

diff --git a/browser/base/content/aboutDialog.js b/browser/base/content/aboutDialog.js
index d9b18acf0b..e92d955812 100644
--- a/browser/base/content/aboutDialog.js
+++ b/browser/base/content/aboutDialog.js
@@ -96,6 +96,7 @@ function init() {
       buildStamp.slice(12, 14),
     ].join(":");
     versionIdKey += "-gorilla";
+    versionAttributes.build = Services.prefs.getIntPref("gorilla.build.number", 0);
   }
 
   // Use Fluent arguments for append version and the architecture of the build
@@ -107,6 +108,16 @@ function init() {
     versionAttributes
   );
 
+  // GORILLA D-157-38 part 2 (2026-10-09): under the version line, the build's own BuildID in full, the string
+  // the harness reports, so the owner can tell which build is installed.
+  let gorillaBuildId = document.getElementById("gorilla-buildid");
+  if (gorillaBuildId && /^\d{14}$/.test(buildStamp)) {
+    document.l10n.setAttributes(gorillaBuildId, "aboutDialog-buildid-gorilla", {
+      buildid: buildStamp,
+    });
+    gorillaBuildId.hidden = false;
+  }
+
   // Show a release notes link if we have a URL.
   let relNotesLink = document.getElementById("releasenotes");
   let relNotesPrefType = Services.prefs.getPrefType(
