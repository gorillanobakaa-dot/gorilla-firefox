+
+/* Link all Label and Link colors for high contrast */
+label, description, .text-link, .help-button, h1, h2 {
+  color: #00FFFF !important; /* GORILLA 2026-08-01: harmonized to theme cyan */
+}
+
+.text-link {
+  color: #35b3ee !important;
+}
+
+/* Global Background Force */
+#root, body {
+  background-color: #000000 !important;
+}
+
+.visually-hidden {
+  display: none !important;
+}
+
+/* TABS & BROWSING SIDEBAR GORILLA DECORATION */
+@media (min-width: 1300px) {
+  #categories[currentview="paneTabsBrowsing"] ~ .main-content::after {
+    content: "" !important;
+    display: block !important;
+    position: fixed !important;
+    right: 40px !important;
+    top: 180px !important;
+    width: 500px !important;
+    height: 500px !important;
+    background-image: url("chrome://branding/content/about-logo.png") !important;
+    background-repeat: no-repeat !important;
+    background-position: center !important;
+    background-size: contain !important;
+    pointer-events: none !important;
+    z-index: 10 !important;
+    opacity: 0.85 !important;
+}
+}
+
+/* Disable global Gorilla watermark specifically on the Preferences page */
+#content {
+  background-image: none !important;
+}
+
+/* Monolingual lock: Hide language picker and add button in Website Language preferences */
+#websiteLanguagePickerWrapper,
+#websiteLanguagePicker,
+#websiteLanguageAddLanguage {
