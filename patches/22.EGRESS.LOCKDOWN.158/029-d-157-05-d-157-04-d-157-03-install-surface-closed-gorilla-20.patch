# Gorilla 158 privacy cut
# D-157-05/D-157-04/D-157-03 install surface closed (Gorilla 2026-10-15: close every avenue so no one can install anything remotely or trick users into installing it): locked extensions.webapi.enabled=false, block_mozAddonManager, xpinstall.enabled=false, InstallTrigger off, recommendations off, every addons.mozilla.org URL pref empty, taskbar tabs off; about:addons shows why nothing can be added instead of the AMO promo, link and search box; Debug Add-ons, Add Dictionaries and about:debugging Load Temporary Add-on are not offered; the five PHYSICAL LOCKs no longer have the Cu.isInAutomation bypass (an env var plus a pref a user can be talked into).
# Files: browser/app/profile/firefox.js, browser/base/content/browser-context.inc.xhtml, browser/base/content/nsContextMenu.sys.mjs, devtools/client/aboutdebugging/src/modules/debug-target-support.js, toolkit/locales/en-US/toolkit/about/aboutAddons.ftl, toolkit/mozapps/extensions/content/aboutaddons-utils.mjs, toolkit/mozapps/extensions/content/components/addon-list.mjs, toolkit/mozapps/extensions/content/components/addon-page-header.mjs, toolkit/mozapps/extensions/content/components/addon-page-options.mjs, toolkit/mozapps/extensions/internal/XPIDatabase.sys.mjs, toolkit/mozapps/extensions/internal/XPIInstall.sys.mjs, toolkit/mozapps/extensions/internal/XPIProvider.sys.mjs

diff --git a/browser/app/profile/firefox.js b/browser/app/profile/firefox.js
index 1b99c98d96..eb1aebcbbb 100644
--- a/browser/app/profile/firefox.js
+++ b/browser/app/profile/firefox.js
@@ -4158,6 +4158,23 @@ pref("browser.theme.toolbar-theme", 0, locked);
 // D-157-05 uBlock only: no chrome-privileged console, no remote debugging
 pref("devtools.chrome.enabled", false, locked);
 pref("devtools.debugger.remote-enabled", false, locked);
+// D-157-05 (owner 2026-10-15: "close every avenue so no one can install remotely anything or trick the users into
+// installing it themselves"): no page gets the add-on install APIs, nothing is downloaded before the refusal,
+// no "Install Add-on From File", no link or search box pointing at addons.mozilla.org, no recommendations
+pref("extensions.webapi.enabled", false, locked);
+pref("privacy.resistFingerprinting.block_mozAddonManager", true, locked);
+pref("xpinstall.enabled", false, locked);
+pref("extensions.InstallTrigger.enabled", false, locked);
+pref("extensions.htmlaboutaddons.recommendations.enabled", false, locked);
+pref("extensions.getAddons.showPane", false, locked);
+pref("extensions.getAddons.search.browseURL", "", locked);
+pref("extensions.getAddons.link.url", "", locked);
+pref("extensions.getAddons.get.url", "", locked);
+pref("extensions.getAddons.discovery.api_url", "", locked);
+pref("extensions.getAddons.browserMappings.url", "", locked);
+pref("extensions.recommendations.themeRecommendationUrl", "", locked);
+// no site installed as a separate app window (Windows only in 158)
+pref("browser.taskbarTabs.enabled", false, locked);
 
 // D-157-06 fingerprinting (local time, page dark mode and per-site zoom kept)
 pref("privacy.fingerprintingProtection", true, locked);
