# Gorilla 158 privacy cut
# Rebase-set review 2026-10-15 (superseded 157 patches whose logic was not in 158): DNS negative cache 3 s (03.NETWORKING nsHostResolver; 158 turned the constant into network.dnsNegativeCacheExpiration); Gorilla wording carried to the 158 ids of browser.ftl search-mode chips, preferences.ftl (5 labels), appmenu Save Page As, netError, extensions.ftl site-permission headers (08.Look).
# Files: browser/app/profile/firefox.js, browser/locales/en-US/browser/appmenu.ftl, browser/locales/en-US/browser/browser.ftl, browser/locales/en-US/browser/preferences/preferences.ftl, toolkit/locales/en-US/toolkit/global/extensions.ftl, toolkit/locales/en-US/toolkit/neterror/netError.ftl

diff --git a/browser/app/profile/firefox.js b/browser/app/profile/firefox.js
index eb1aebcbbb..0e224c736b 100644
--- a/browser/app/profile/firefox.js
+++ b/browser/app/profile/firefox.js
@@ -4050,6 +4050,10 @@ pref("network.buffer.cache.count",                  128);
 pref("network.buffer.cache.size",                   524288);
 pref("network.dns.disablePrefetch", true, locked);
 pref("network.dns.disablePrefetchFromHTTPS", true, locked);
+// GORILLA (03.NETWORKING nsHostResolver, carried to 158 by rebase-set review 2026-10-15): a failed DNS lookup is
+// remembered 3 s, not 60, so a call's signalling host that changed address is reached again quickly. 158 replaced
+// the NEGATIVE_RECORD_LIFETIME constant the 157 patch edited with this pref.
+pref("network.dnsNegativeCacheExpiration", 3);
 pref("network.http.connection-timeout",             10);
 pref("network.http.http2.enabled",                  true);
 pref("network.http.http2.send-buffer-size", 0);
