# Gorilla 157 privacy cut
# D-157-38 part 2: Help > About reads '157.0 (64-bit) build 29, built YY:MM:DD:HH:MM:SS' and under it 'Build ID <14 digits>' (the string the harness reports); build number = branding pref gorilla.build.number, raised per release candidate
# Files: browser/base/content/aboutDialog.js, browser/base/content/aboutDialog.xhtml, browser/branding/gorilla/pref/firefox-branding.js, browser/locales/en-US/browser/aboutDialog.ftl

diff --git a/browser/base/content/aboutDialog.js b/browser/base/content/aboutDialog.js
index a5fc845c92..36fe8783af 100644
--- a/browser/base/content/aboutDialog.js
+++ b/browser/base/content/aboutDialog.js
@@ -96,6 +96,8 @@ function init() {
       buildStamp.slice(12, 14),
     ].join(":");
     versionIdKey += "-gorilla";
+    // GORILLA D-157-38 (2026-10-09): the build number (branding pref, raised per release candidate)
+    versionAttributes.build = Services.prefs.getIntPref("gorilla.build.number", 0);
   }
 
   // Use Fluent arguments for append version and the architecture of the build
@@ -107,6 +109,16 @@ function init() {
     versionAttributes
   );
 
+  // GORILLA D-157-38 (2026-10-09): under the version line, the build's own BuildID in full - the string the build
+  // harness reports - so anyone can match this browser to a report or a release page.
+  let buildIdField = document.getElementById("gorilla-buildid");
+  if (buildIdField && /^\d{14}$/.test(buildStamp)) {
+    document.l10n.setAttributes(buildIdField, "aboutDialog-buildid-gorilla", {
+      buildid: buildStamp,
+    });
+    buildIdField.hidden = false;
+  }
+
