# Gorilla 157 privacy cut
# Desktop-launcher.exe (shipped since 155) downloads the Mozilla stub installer over WinHTTP when Firefox is not found: not built, not packaged, the NSIS desktop copy is a no-op.
# Files: browser/app/moz.build, browser/installer/package-manifest.in, browser/installer/windows/nsis/shared.nsh

diff --git a/browser/app/moz.build b/browser/app/moz.build
index 44e4acb25c..6022a519c4 100644
--- a/browser/app/moz.build
+++ b/browser/app/moz.build
@@ -197,10 +197,7 @@ if CONFIG["OS_ARCH"] == "WINNT":
     # only enable it for processes that are not using JIT in xul.dll.
     LINK_FLAGS["CETCOMPAT"] = []
 
-if CONFIG["DESKTOP_LAUNCHER_ENABLED"]:
-    DIRS += [
-        "desktop-launcher",
-    ]
+# GORILLA excised: desktop-launcher (a WinHTTP downloader of the Mozilla stub installer; was: if DESKTOP_LAUNCHER_ENABLED: DIRS += ["desktop-launcher"])
 
 if CONFIG["OS_ARCH"] == "Darwin":
     OS_LIBS += [
diff --git a/browser/installer/package-manifest.in b/browser/installer/package-manifest.in
index d97e6f9ec3..b744b4a66e 100644
--- a/browser/installer/package-manifest.in
+++ b/browser/installer/package-manifest.in
@@ -455,9 +455,7 @@ bin/libfreebl_64int_3.so
 @RESPATH@/jogfile.json
 #endif
 
-#if defined(DESKTOP_LAUNCHER_ENABLED)
-@BINPATH@/desktop-launcher/desktop-launcher@BIN_SUFFIX@
-#endif
+; GORILLA excised: desktop-launcher (downloads the Mozilla stub installer over WinHTTP)
 
 #if defined(BUILT_BY_MOZILLA)
 @RESPATH@/distribution/*
diff --git a/browser/installer/windows/nsis/shared.nsh b/browser/installer/windows/nsis/shared.nsh
index b81c7ef59b..9565ba7bac 100755
--- a/browser/installer/windows/nsis/shared.nsh
+++ b/browser/installer/windows/nsis/shared.nsh
@@ -115,6 +115,8 @@
 
 ; Installs the desktop launcher and sets a registry key to show that we did it.
 Function InstallDesktopLauncher
+  ; GORILLA excised: desktop-launcher is not built; nothing to copy to the desktop
+  Return
   ClearErrors
   ; Copy the launcher into the user's Desktop with an appropriate name
   CopyFiles /SILENT /FILESONLY "$INSTDIR\desktop-launcher\desktop-launcher.exe" "$DESKTOP\${BrandShortName}.exe"
