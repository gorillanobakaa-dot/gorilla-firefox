diff --git a/toolkit/modules/RustSharedRemoteSettingsService.sys.mjs b/toolkit/modules/RustSharedRemoteSettingsService.sys.mjs
index cfcd3b0803..228eabd047 100644
--- a/toolkit/modules/RustSharedRemoteSettingsService.sys.mjs
+++ b/toolkit/modules/RustSharedRemoteSettingsService.sys.mjs
@@ -160,9 +160,15 @@ class _SharedRemoteSettingsService {
     //
     // * In contrast, `RemoteSettingsService::update_config` returns the error
     //   when it parses a cannot-be-a-base `config.server.url`.
-    return !Utils.shouldSkipRemoteActivity || url != Utils.SERVER_URL
-      ? new RemoteSettingsServer.Custom({ url })
-      : null;
+    // GORILLA UNLEASHED - PHYSICAL LOCK (egress): never null. A null server makes the Rust component fall
+    // back to the PRODUCTION server (firefox.settings.services.mozilla.com). The dummy data: URI cannot be
+    // parsed by update_config, so the locked case gets an address that routes nowhere.
+    return new RemoteSettingsServer.Custom({
+      url:
+        Utils.shouldSkipRemoteActivity && url == Utils.SERVER_URL
+          ? "http://0.0.0.0/v1"
+          : url,
+    });
   }
 }
 
