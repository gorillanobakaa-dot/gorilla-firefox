# Gorilla 157 privacy cut
# D-157-39 (2026-10-08, build 28 item 2): Satellite mode leaves calls alone - camera/microphone-allowed sites and gorilla.linkmode.call_sites keep desktop identity and JavaScript at every level
# Files: browser/app/profile/firefox.js, browser/locales/en-US/browser/gorillaSatellite.ftl, browser/modules/GorillaLinkMode.sys.mjs

diff --git a/browser/app/profile/firefox.js b/browser/app/profile/firefox.js
