 pref("gorilla.linkmode.mobile_pages", true);
 // D-157-33: Very slow link runs no JavaScript (per tab; a site can be allowed from the toolbar button)
 pref("gorilla.linkmode.no_javascript", true);
+// D-157-39: call sites keep their desktop version and JavaScript at every Satellite level. Also any site the user
+// allowed the camera or microphone. Local list, comma-separated hosts; nothing is fetched.
+pref("gorilla.linkmode.call_sites", "web.whatsapp.com,meet.google.com,meet.jit.si,teams.microsoft.com,teams.live.com,app.zoom.us,www.messenger.com,discord.com");
