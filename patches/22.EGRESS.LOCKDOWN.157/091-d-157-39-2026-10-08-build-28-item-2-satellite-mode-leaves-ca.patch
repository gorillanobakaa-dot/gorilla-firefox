+  // A call site (D-157-39): camera or microphone allowed (remembered, or for this tab only: SitePermissions reads both,
+  // given the tab's browser), or a host on the local list.
+  _callSite(principal, browser) {
+    try {
+      const host = principal.host.toLowerCase();
+      const listed = Services.prefs
+        .getStringPref(CALL_SITES_PREF, "")
+        .split(",")
+        .map(h => h.trim().toLowerCase())
+        .filter(Boolean);
+      if (listed.includes(host)) {
+        return true;
+      }
+      return CALL_PERMISSIONS.some(
+        id =>
+          lazy.SitePermissions.getForPrincipal(principal, id, browser).state ==
+          lazy.SitePermissions.ALLOW
+      );
+    } catch (e) {
+      return false;
+    }
+  },
+
   // Per site, for every top-level page, decided before the page is requested so nothing is downloaded twice:
   // - identity: a site the user sent back to its desktop version gets the desktop identity in that tab (header and
   //   navigator alike, through the tab's customUserAgent); any other site gets "", the mobile identity of the prefs;
