@@ -1326,6 +1327,22 @@ var gXPInstallObserver = {
         );
         break;
       }
+      case "addon-install-gorilla-refused": {
+        // GORILLA UNLEASHED: AddonManager refused the install (D-157-05: add-ons are built in only). Say so, so
+        // the user does not retry or think the browser is broken (claim EXT-03).
+        options.removeOnDismissal = true;
+        options.persistent = false;
+        PopupNotifications.show(
+          browser,
+          aTopic,
+          await lazy.l10n.formatValue("gorilla-addon-install-refused"),
+          gUnifiedExtensions.getPopupAnchorID(browser, window),
+          null,
+          null,
+          options
+        );
+        break;
+      }
       case "addon-install-fullscreen-blocked": {
         // AddonManager denied installation because we are in DOM fullscreen
         this.logWarningFullScreenInstallBlocked();
