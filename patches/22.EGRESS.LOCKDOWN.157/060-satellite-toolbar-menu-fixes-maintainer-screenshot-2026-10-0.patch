+      "gorilla-satellite-button",
+      "gorilla-satellite-button-settings",
+      "gorilla-satellite-button-desktop-site",
+      "gorilla-satellite-mobile-pages",
+      "gorilla-satellite-no-javascript",
+      "gorilla-satellite-button-javascript-site",
+      ...LEVEL_NAMES.map(n => `gorilla-satellite-mode-${n}`),
+      ...LEVEL_NAMES.map(n => `gorilla-satellite-button-${n}`),
+    ];
+    const l10n = new Localization(["browser/gorillaSatellite.ftl"], true);
+    const messages = l10n.formatMessagesSync(ids.map(id => ({ id })));
+    gStrings = {};
+    ids.forEach((id, i) => {
+      gStrings[id] = {};
+      for (const { name, value } of messages[i]?.attributes || []) {
+        gStrings[id][name] = value;
+      }
+    });
+  }
+  return gStrings;
+}
+
+// Level 1 "Satellite": study S2, S3, S10, S12 (prefs part).
+const SATELLITE = {
+  "media.autoplay.default": 5, // S2: no autoplay, muted video included
+  "media.preload.default": 1, // S3: no media preload (Firefox's own cellular value)
+  "media.preload.auto": 2, // S3: metadata only
+  "network.http.connection-timeout": 30, // S10
+  "network.http.tls-handshake-timeout": 60, // S10
+  "network.http.response.timeout": 300, // S10 / F6
+  "network.http.connection-retry-timeout": 1000, // S10: no backup connection before a 600 ms SYN-ACK
+  "network.dnsCacheExpiration": 600, // S12
+  "network.dnsCacheExpirationGracePeriod": 3600, // S12
+  // F7 measured 2026-10-03 (bench B1): with no disk cache a restart re-fetches every page (95.7 s at 5 KB/s).
+  "browser.cache.disk.enable": true, // F7: keep pages across restarts on slow links
+  "browser.cache.disk.smart_size.enabled": false,
+  "browser.cache.disk.capacity": 262144, // 256 MiB
+  // D-157-33 (bench 2026-10-04: a restart still took 40.9 s at 5 KB/s, as long as a first visit): Gorilla empties
+  // the cache at every shutdown, so F7's disk cache never survived a restart. Kept while a level is on; history,
+  // form data and downloads are still wiped at shutdown.
