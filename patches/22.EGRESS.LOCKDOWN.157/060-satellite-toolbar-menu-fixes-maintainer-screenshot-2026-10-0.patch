+    popup.appendChild(settings);
+    popup.addEventListener("popupshowing", () => {
+      const level = String(this.level());
+      for (const item of popup.querySelectorAll("menuitem[type='radio']")) {
+        if (item.getAttribute("value") == level) {
+          item.setAttribute("checked", "true");
+        } else {
+          item.removeAttribute("checked");
+        }
+      }
+      if (Services.prefs.getBoolPref(MOBILE_PREF, true)) {
+        mobile.setAttribute("checked", "true");
+      } else {
+        mobile.removeAttribute("checked");
+      }
+      // The desktop-version switch only means something while mobile pages are asked for, on a web page.
+      const principal = win().gBrowser.contentPrincipal;
+      const web = principal.schemeIs("http") || principal.schemeIs("https");
+      desktopSite.hidden = !this.mobilePages() || !web;
+      setChecked(
+        desktopSite,
+        web && this._sitePermitted(principal, DESKTOP_SITE_PERM)
+      );
+      // the JavaScript switches belong to Very slow link only
+      noJs.hidden = this.level() != 2;
+      setChecked(noJs, Services.prefs.getBoolPref(NO_JS_PREF, true));
+      jsSite.hidden = !this.noJavascript() || !web;
+      setChecked(jsSite, web && this._sitePermitted(principal, JS_SITE_PERM));
+    });
+    button.appendChild(popup);
+    this._showLevel(button);
+    return button;
+  },
+
+  _showLevel(button) {
+    const s = strings();
+    const level = this.level();
+    button.setAttribute(
+      "label",
+      s[`gorilla-satellite-button-${LEVEL_NAMES[level]}`].label
+    );
+    button.setAttribute("tooltiptext", s["gorilla-satellite-button"].tooltiptext);
+    button.setAttribute("gorilla-level", String(level));
+  },
+
+  _showLevelOnButtons() {
+    // Only once a button was built (that is when the words are read): a level change before the first window
+    // must not load CustomizableUI early.
+    if (!gStrings) {
+      return;
+    }
+    for (const instance of lazy.CustomizableUI.getWidget(BUTTON_ID)?.instances || []) {
+      if (instance.node) {
+        this._showLevel(instance.node);
+      }
+    }
+  },
+
+  level() {
+    const n = Services.prefs.getIntPref(LINKMODE_PREF, 0);
+    return n >= 0 && n < LEVELS.length ? n : 0;
+  },
+
+  apply() {
+    const level = this.level();
+    const mobile = this.mobilePages();
+    const noJs = this.noJavascript();
+    const key = `${level}/${mobile}/${noJs}`;
+    if (key === this._applied) {
+      return;
+    }
+    const branch = Services.prefs.getDefaultBranch("");
+    const values = { ...LEVELS[level], ...(mobile ? mobileIdentity() : {}) };
+    for (const name of ALL_KEYS) {
+      let value = name in values ? values[name] : this._shipped[name];
+      if (value === undefined) {
+        // Not defined in the shipped build and not part of this level.
+        if (name === "gorilla.network.save_data") {
+          value = false;
+        } else if (name === "permissions.default.image") {
+          value = 1; // pictures on: Off must never leave them blocked
+        } else if (MOBILE_KEYS.includes(name)) {
+          // An override that exists, even empty, replaces the identity: it has to be gone, not "".
+          if (branch.getPrefType(name) != Ci.nsIPrefBranch.PREF_INVALID) {
+            branch.deleteBranch(name);
+          }
+          continue;
+        } else {
+          continue;
+        }
+      }
+      try {
+        setDefault(branch, name, value);
+      } catch (e) {
+        // A locked pref keeps its locked value.
+        console.error(`GorillaLinkMode: ${name}`, e);
+      }
+    }
+    this._watchRequests(mobile || noJs);
+    this._resetTabs(mobile, noJs);
+    this._applied = key;
+  },
+};
