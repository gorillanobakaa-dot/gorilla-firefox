+  "privacy.clearOnShutdown_v2.cache": false,
+};
+
+// Level 2 "Very slow link": level 1 with GEO timeouts, plus S6, S7, S11.
+const VERY_SLOW = {
+  ...SATELLITE,
+  "network.http.connection-timeout": 60, // S10, GEO
+  "gfx.downloadable_fonts.enabled": false, // S6: no web fonts
+  "gorilla.network.save_data": true, // S7: "Save-Data: on" (nsHttpChannel::SetSaveData)
+  "network.http.max-persistent-connections-per-server": 6, // S11
+  "permissions.default.image": 2, // S5: no pictures (per site: Page Info > Permissions > Load Images)
+  // D-157-33 (bench 2026-10-04: the same page again took 21.5 s, its 103 KB HTML downloaded again every time):
+  // a page in the cache is shown without asking the site whether it changed. Reload still fetches a fresh copy.
+  "browser.cache.check_doc_frequency": 2,
+};
+
+const LEVELS = [{}, SATELLITE, VERY_SLOW];
+
+// Firefox for Android's identity: the same strings toolkit/components/resistfingerprinting/nsRFPService.h
+// reports on Android, so a mobile-mode Gorilla looks like the many real Firefox phones, not like something new.
+function mobileIdentity() {
+  const v = `${parseInt(Services.appinfo.version)}.0`;
+  return {
+    "general.useragent.override": `Mozilla/5.0 (Android 10; Mobile; rv:${v}) Gecko/${v} Firefox/${v}`,
+    "general.appversion.override": "5.0 (Android 10)",
+    "general.oscpu.override": "Linux armv81",
+    "general.platform.override": "Linux armv81",
+  };
+}
+const MOBILE_KEYS = Object.keys(mobileIdentity());
+const ALL_KEYS = [...Object.keys(VERY_SLOW), ...MOBILE_KEYS];
+
+// XUL menu checkboxes read checked="true"
+function setChecked(item, on) {
+  if (on) {
+    item.setAttribute("checked", "true");
+  } else {
+    item.removeAttribute("checked");
+  }
+}
+
+function getDefault(branch, name) {
+  switch (branch.getPrefType(name)) {
+    case Ci.nsIPrefBranch.PREF_INT:
+      return branch.getIntPref(name);
+    case Ci.nsIPrefBranch.PREF_BOOL:
+      return branch.getBoolPref(name);
+    case Ci.nsIPrefBranch.PREF_STRING:
+      return branch.getStringPref(name);
+  }
+  return undefined;
+}
+
+function setDefault(branch, name, value) {
+  if (typeof value === "boolean") {
+    branch.setBoolPref(name, value);
+  } else if (typeof value === "number") {
+    branch.setIntPref(name, value);
+  } else {
+    branch.setStringPref(name, String(value));
+  }
+}
+
+export const GorillaLinkMode = {
+  _shipped: null,
+  _applied: "",
+  _desktopUA: "",
+  _watchingRequests: false,
+
+  init() {
+    if (this._shipped) {
+      return;
+    }
+    const branch = Services.prefs.getDefaultBranch("");
+    this._shipped = {};
+    for (const name of ALL_KEYS) {
+      this._shipped[name] = getDefault(branch, name);
+    }
+    // The desktop identity, read before any level can override it: what a site switched back to desktop gets.
+    this._desktopUA = Cc["@mozilla.org/network/protocol;1?name=http"].getService(
+      Ci.nsIHttpProtocolHandler
+    ).userAgent;
+    Services.prefs.addObserver(LINKMODE_PREF, this);
+    Services.prefs.addObserver(MOBILE_PREF, this);
+    Services.prefs.addObserver(NO_JS_PREF, this);
+    Services.obs.addObserver(this, "browser-window-before-show");
+    this.apply();
+  },
+
+  observe(subject, topic) {
+    if (topic == "browser-window-before-show") {
+      Services.obs.removeObserver(this, "browser-window-before-show");
+      try {
+        this._createButton();
+      } catch (e) {
+        // The switch in Settings still works; the levels never depend on the button.
+        console.error("GorillaLinkMode: toolbar button", e);
+      }
+      return;
+    }
+    if (topic == "http-on-modify-request") {
+      this._choosePerSite(subject);
+      return;
+    }
+    this.apply();
+    this._showLevelOnButtons();
+  },
+
+  mobilePages() {
+    return this.level() > 0 && Services.prefs.getBoolPref(MOBILE_PREF, true);
+  },
+
+  noJavascript() {
+    return this.level() == 2 && Services.prefs.getBoolPref(NO_JS_PREF, true);
+  },
+
+  _sitePermitted(principal, type) {
+    return (
+      Services.perms.testPermissionFromPrincipal(principal, type) ==
+      Services.perms.ALLOW_ACTION
+    );
+  },
+
+  // Per site, for every top-level page, decided before the page is requested so nothing is downloaded twice:
+  // - identity: a site the user sent back to its desktop version gets the desktop identity in that tab (header and
+  //   navigator alike, through the tab's customUserAgent); any other site gets "", the mobile identity of the prefs;
+  // - JavaScript: off in the tab unless the user allowed the site.
+  _choosePerSite(subject) {
+    try {
+      const channel = subject.QueryInterface(Ci.nsIHttpChannel);
+      const info = channel.loadInfo;
+      if (
+        info.externalContentPolicyType != Ci.nsIContentPolicy.TYPE_DOCUMENT
+      ) {
+        return;
+      }
+      const bc = info.targetBrowsingContext || info.browsingContext;
+      if (!bc || bc.parent) {
+        return;
+      }
+      const principal = Services.scriptSecurityManager.createContentPrincipal(
+        channel.URI,
+        {}
+      );
+      if (this.mobilePages()) {
+        const desktop = this._sitePermitted(principal, DESKTOP_SITE_PERM);
+        const ua = desktop ? this._desktopUA : "";
+        if (bc.customUserAgent != ua) {
+          bc.customUserAgent = ua;
+        }
+        if (desktop) {
+          channel.setRequestHeader("User-Agent", this._desktopUA, false);
+        }
+      }
+      const js =
+        !this.noJavascript() || this._sitePermitted(principal, JS_SITE_PERM);
+      if (bc.allowJavascript != js) {
+        bc.allowJavascript = js;
+      }
+    } catch (e) {
+      console.error("GorillaLinkMode: per-site choice", e);
+    }
+  },
+
+  // Leaving mobile pages or no-JavaScript: tabs that are already open drop the per-tab choices they were given.
+  _resetTabs(mobile, noJs) {
+    for (const win of Services.wm.getEnumerator("navigator:browser")) {
+      for (const browser of win.gBrowser?.browsers || []) {
+        const bc = browser.browsingContext;
+        if (!bc) {
+          continue;
+        }
+        if (!mobile && bc.customUserAgent) {
+          bc.customUserAgent = "";
+        }
+        if (!noJs && !bc.allowJavascript) {
+          bc.allowJavascript = true;
+        }
+      }
+    }
+  },
+
+  _watchRequests(on) {
+    if (on == this._watchingRequests) {
+      return;
+    }
+    if (on) {
+      Services.obs.addObserver(this, "http-on-modify-request");
+    } else {
+      Services.obs.removeObserver(this, "http-on-modify-request");
+    }
+    this._watchingRequests = on;
+  },
+
+  _createButton() {
+    const { CustomizableUI } = lazy;
+    CustomizableUI.createWidget({
+      id: BUTTON_ID,
+      type: "custom",
+      defaultArea: CustomizableUI.AREA_NAVBAR,
+      onBuild: doc => this._buildButton(doc),
+    });
+    if (!Services.prefs.getBoolPref(PLACED_PREF, false)) {
+      const urlbar = CustomizableUI.getPlacementOfWidget("urlbar-container");
+      const placed = CustomizableUI.getPlacementOfWidget(BUTTON_ID);
+      if (urlbar && placed && placed.area == urlbar.area) {
+        CustomizableUI.addWidgetToArea(
+          BUTTON_ID,
+          urlbar.area,
+          urlbar.position + 1
+        );
+      }
+      Services.prefs.setBoolPref(PLACED_PREF, true);
+    }
+  },
+
+  _buildButton(doc) {
+    const s = strings();
+    // ownerDocument.defaultView, not ownerGlobal: this 157 tree's WebIDL has no Node.ownerGlobal, so it is undefined
+    // (2026-10-04, build 23: the menu showed every item and its commands threw)
+    const win = () => button.ownerDocument.defaultView;
+    const button = doc.createXULElement("toolbarbutton");
+    button.id = BUTTON_ID;
+    button.className = "toolbarbutton-1 chromeclass-toolbar-additional";
+    button.setAttribute("type", "menu");
+    button.setAttribute("removable", "true");
+    const popup = doc.createXULElement("menupopup");
+    LEVEL_NAMES.forEach((name, level) => {
+      const item = doc.createXULElement("menuitem");
+      item.setAttribute("type", "radio");
+      item.setAttribute("name", "gorilla-satellite-level");
+      item.setAttribute("value", String(level));
+      item.setAttribute("label", s[`gorilla-satellite-mode-${name}`].label);
+      item.setAttribute(
+        "tooltiptext",
+        s[`gorilla-satellite-mode-${name}`].title
+      );
+      item.addEventListener("command", () =>
+        Services.prefs.setIntPref(LINKMODE_PREF, level)
+      );
+      popup.appendChild(item);
+    });
+    popup.appendChild(doc.createXULElement("menuseparator"));
+    const mobile = doc.createXULElement("menuitem");
+    mobile.setAttribute("type", "checkbox");
+    mobile.setAttribute("gorilla-item", "mobile-pages");
+    mobile.setAttribute("label", s["gorilla-satellite-mobile-pages"].label);
+    mobile.setAttribute("tooltiptext", s["gorilla-satellite-mobile-pages"].title);
+    mobile.addEventListener("command", () =>
+      Services.prefs.setBoolPref(
+        MOBILE_PREF,
+        !Services.prefs.getBoolPref(MOBILE_PREF, true)
+      )
+    );
+    popup.appendChild(mobile);
+    const desktopSite = doc.createXULElement("menuitem");
+    desktopSite.setAttribute("type", "checkbox");
+    desktopSite.setAttribute("gorilla-item", "desktop-site");
+    desktopSite.setAttribute(
+      "label",
+      s["gorilla-satellite-button-desktop-site"].label
+    );
+    desktopSite.setAttribute(
+      "tooltiptext",
+      s["gorilla-satellite-button-desktop-site"].tooltiptext
+    );
+    desktopSite.addEventListener("command", () => {
+      const principal = win().gBrowser.contentPrincipal;
+      if (desktopSite.getAttribute("checked") == "true") {
+        Services.perms.addFromPrincipal(
+          principal,
+          DESKTOP_SITE_PERM,
+          Services.perms.ALLOW_ACTION
+        );
+      } else {
+        Services.perms.removeFromPrincipal(principal, DESKTOP_SITE_PERM);
+      }
+      win().gBrowser.selectedBrowser.reload();
+    });
+    popup.appendChild(desktopSite);
+    const noJs = doc.createXULElement("menuitem");
+    noJs.setAttribute("type", "checkbox");
+    noJs.setAttribute("gorilla-item", "no-javascript");
+    noJs.setAttribute("label", s["gorilla-satellite-no-javascript"].label);
+    noJs.setAttribute("tooltiptext", s["gorilla-satellite-no-javascript"].title);
