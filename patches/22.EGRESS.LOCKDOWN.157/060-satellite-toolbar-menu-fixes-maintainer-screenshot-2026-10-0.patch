+    jsSite.setAttribute("gorilla-item", "javascript-site");
+    jsSite.setAttribute(
+      "label",
+      s["gorilla-satellite-button-javascript-site"].label
+    );
+    jsSite.setAttribute(
+      "tooltiptext",
+      s["gorilla-satellite-button-javascript-site"].tooltiptext
