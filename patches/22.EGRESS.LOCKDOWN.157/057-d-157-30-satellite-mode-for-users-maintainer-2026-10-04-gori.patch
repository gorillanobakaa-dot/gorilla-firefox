   },
 
-  observe() {
+  observe(subject, topic) {
+    if (topic == "browser-window-before-show") {
+      Services.obs.removeObserver(this, "browser-window-before-show");
+      try {
+        this._createButton();
+      } catch (e) {
+        // The switch in Settings still works; the levels never depend on the button.
+        console.error("GorillaLinkMode: toolbar button", e);
+      }
+      return;
+    }
     this.apply();
+    this._showLevelOnButtons();
+  },
+
+  _createButton() {
+    const { CustomizableUI } = lazy;
+    CustomizableUI.createWidget({
+      id: BUTTON_ID,
+      type: "custom",
+      defaultArea: CustomizableUI.AREA_NAVBAR,
+      onBuild: doc => this._buildButton(doc),
+    });
+    if (!Services.prefs.getBoolPref(PLACED_PREF, false)) {
+      const urlbar = CustomizableUI.getPlacementOfWidget("urlbar-container");
+      const placed = CustomizableUI.getPlacementOfWidget(BUTTON_ID);
+      if (urlbar && placed && placed.area == urlbar.area) {
+        CustomizableUI.addWidgetToArea(
+          BUTTON_ID,
+          urlbar.area,
+          urlbar.position + 1
+        );
+      }
+      Services.prefs.setBoolPref(PLACED_PREF, true);
+    }
+  },
+
+  _buildButton(doc) {
+    const s = strings();
+    const button = doc.createXULElement("toolbarbutton");
+    button.id = BUTTON_ID;
+    button.className = "toolbarbutton-1 chromeclass-toolbar-additional";
+    button.setAttribute("type", "menu");
+    button.setAttribute("removable", "true");
+    const popup = doc.createXULElement("menupopup");
+    LEVEL_NAMES.forEach((name, level) => {
+      const item = doc.createXULElement("menuitem");
+      item.setAttribute("type", "radio");
+      item.setAttribute("name", "gorilla-satellite-level");
+      item.setAttribute("value", String(level));
+      item.setAttribute("label", s[`gorilla-satellite-mode-${name}`].label);
+      item.setAttribute(
+        "tooltiptext",
+        s[`gorilla-satellite-mode-${name}`].title
+      );
+      item.addEventListener("command", () =>
+        Services.prefs.setIntPref(LINKMODE_PREF, level)
+      );
+      popup.appendChild(item);
+    });
+    popup.appendChild(doc.createXULElement("menuseparator"));
+    const settings = doc.createXULElement("menuitem");
+    settings.setAttribute("label", s["gorilla-satellite-button-settings"].label);
+    settings.addEventListener("command", () =>
+      doc.ownerGlobal.openPreferences("paneGeneral")
+    );
+    popup.appendChild(settings);
+    popup.addEventListener("popupshowing", () => {
+      const level = String(this.level());
+      for (const item of popup.querySelectorAll("menuitem[type='radio']")) {
+        if (item.getAttribute("value") == level) {
+          item.setAttribute("checked", "true");
+        } else {
+          item.removeAttribute("checked");
+        }
+      }
+    });
+    button.appendChild(popup);
+    this._showLevel(button);
+    return button;
+  },
+
+  _showLevel(button) {
+    const s = strings();
+    const level = this.level();
+    button.setAttribute(
+      "label",
+      s[`gorilla-satellite-button-${LEVEL_NAMES[level]}`].label
+    );
+    button.setAttribute("tooltiptext", s["gorilla-satellite-button"].tooltiptext);
+    button.setAttribute("gorilla-level", String(level));
+  },
+
+  _showLevelOnButtons() {
+    // Only once a button was built (that is when the words are read): a level change before the first window
+    // must not load CustomizableUI early.
+    if (!gStrings) {
+      return;
+    }
+    for (const instance of lazy.CustomizableUI.getWidget(BUTTON_ID)?.instances || []) {
+      if (instance.node) {
+        this._showLevel(instance.node);
+      }
+    }
   },
 
   level() {
