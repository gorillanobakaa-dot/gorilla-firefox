+/* GORILLA UNLEASHED - SATELLITE MODE: the toolbar switch (maintainer, 2026-10-04: easy to find, in the empty
+ * space next to the address bar). Toolbar buttons hide their words; this one shows them, because the words are
+ * the point: the name and the level in use. Icon and words share one hover shape; pressed look = a level is on. */
+#gorilla-satellite-button {
+  list-style-image: url("chrome://browser/skin/gorilla-satellite.svg");
+
+  > .toolbarbutton-icon {
+    width: calc(var(--toolbarbutton-padding-inner) + 16px + 2px);
+    padding-inline-end: 2px;
+    border-start-end-radius: 0;
+    border-end-end-radius: 0;
+  }
+
+  > .toolbarbutton-text {
+    display: flex;
+    align-items: center;
+    white-space: nowrap;
+    padding-inline-start: 2px;
+    border-start-start-radius: 0;
+    border-end-start-radius: 0;
+  }
+
+  /* a level is on: the button looks pressed, the way a switched-on toolbar button does ([checked]) */
+  &:is([gorilla-level="1"], [gorilla-level="2"]) > :is(.toolbarbutton-icon, .toolbarbutton-text) {
+    background-color: var(--toolbarbutton-background-color-active);
+  }
+}
