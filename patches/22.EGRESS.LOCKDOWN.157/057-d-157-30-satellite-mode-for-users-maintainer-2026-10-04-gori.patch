 const LINKMODE_PREF = "gorilla.linkmode";
 
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  CustomizableUI:
+    "moz-src:///browser/components/customizableui/CustomizableUI.sys.mjs",
+});
+
+// The toolbar switch (maintainer, 2026-10-04: "easy to find and quite prominent", in the empty space between the
+// address bar and the extension and menu buttons). It shows its name and the level in use in words; a click opens
+// the three levels, each with the same long explanation on hover as in Settings. The words are in
+// browser/gorillaSatellite.ftl, which Settings reads too. It is created when the first window is about to show,
+// not at browser-before-ui-startup: loading CustomizableUI that early would run before BrowserGlue's UI migrations
+// edit the toolbar layout pref. A user who removes it keeps it removed (CustomizableUI remembers seen widgets, and
+// PLACED_PREF stops the one-time move next to the address bar from happening again).
+const BUTTON_ID = "gorilla-satellite-button";
+const PLACED_PREF = "gorilla.linkmode.button.placed";
+const LEVEL_NAMES = ["off", "satellite", "very-slow"];
+
+let gStrings = null;
+function strings() {
+  if (!gStrings) {
+    const ids = [
+      "gorilla-satellite-button",
+      "gorilla-satellite-button-settings",
+      ...LEVEL_NAMES.map(n => `gorilla-satellite-mode-${n}`),
+      ...LEVEL_NAMES.map(n => `gorilla-satellite-button-${n}`),
+    ];
+    const l10n = new Localization(["browser/gorillaSatellite.ftl"], true);
+    const messages = l10n.formatMessagesSync(ids.map(id => ({ id })));
+    gStrings = {};
+    ids.forEach((id, i) => {
+      gStrings[id] = {};
+      for (const { name, value } of messages[i]?.attributes || []) {
+        gStrings[id][name] = value;
+      }
+    });
+  }
+  return gStrings;
+}
+
 // Level 1 "Satellite": study S2, S3, S10, S12 (prefs part).
 const SATELLITE = {
   "media.autoplay.default": 5, // S2: no autoplay, muted video included
@@ -36,6 +75,7 @@ const VERY_SLOW = {
   "gfx.downloadable_fonts.enabled": false, // S6: no web fonts
   "gorilla.network.save_data": true, // S7: "Save-Data: on" (nsHttpChannel::SetSaveData)
   "network.http.max-persistent-connections-per-server": 6, // S11
+  "permissions.default.image": 2, // S5: no pictures (per site: Page Info > Permissions > Load Images)
 };
 
 const LEVELS = [{}, SATELLITE, VERY_SLOW];
@@ -76,11 +116,114 @@ export const GorillaLinkMode = {
