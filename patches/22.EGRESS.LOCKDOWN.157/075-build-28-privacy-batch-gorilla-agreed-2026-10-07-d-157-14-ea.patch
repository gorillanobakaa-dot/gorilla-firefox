 pref("browser.newtabpage.activity-stream.discoverystream.sections.personalization.inferred.user.enabled", true);
+// GORILLA: personalised new-tab sections off and locked (stock default true; the feeds are cut, D-157-21)
+pref("browser.newtabpage.activity-stream.discoverystream.sections.personalization.enabled", false, locked);
 
 // Override inferred personalization model JSON string that typically comes from rec API. Or "TEST" for a test model.
 pref("browser.newtabpage.activity-stream.discoverystream.sections.personalization.inferred.model.override", "");
@@ -3900,6 +3902,8 @@ pref("browser.contentanalysis.enabled", false, locked);
 pref("browser.contentanalysis.interception_point.clipboard.enabled", false, locked);
 pref("browser.ml.checkForMemory", false, locked);
 pref("browser.ml.enable", false, locked);
+// the extension ML API (it downloads models) stays off and cannot be switched back on (D-157-21)
+pref("extensions.ml.enabled", false, locked);
 pref("browser.ml.modelCacheMaxSize", 0, locked);
 pref("browser.ml.modelHubRootUrl", "", locked);
 pref("browser.newtabpage.activity-stream.telemetry", false, locked);
@@ -4130,6 +4134,10 @@ pref("geo.provider.network.url", "", locked);
 
 // D-157-14 no speculative connections, prefetch, pings or beacons
 pref("beacon.enabled", false, locked);
+// 103 Early Hints preconnect carries its own 10-connection allowance, which beats speculative-parallel-limit 0
+// (audit 2026-10-06); page <link rel=preconnect> is closed at the source too.
+pref("network.early-hints.preconnect.enabled", false, locked);
+pref("network.preconnect", false, locked);
 
 // D-157-15 no MITM-detection ping to Mozilla
 
