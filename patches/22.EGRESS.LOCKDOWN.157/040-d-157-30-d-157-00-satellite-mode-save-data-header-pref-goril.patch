+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// GORILLA UNLEASHED - SATELLITE MODE: slow or satellite link levels.
+//
+// One pref, gorilla.linkmode: 0 = off (the shipped values), 1 = "Satellite" (fast but far: Starlink, GEO
+// broadband), 2 = "Very slow link" (1-60 KB/s). The level's values are written to the DEFAULT branch, so a value
+// the user set by hand always wins, and going back to 0 restores the shipped defaults exactly. Nothing here makes
+// a connection: every value makes the browser fetch less, wait longer, or ask sites for lighter pages
+// (D-157-00, D-157-30). Values: docs/NETWORK-AND-SATELLITE-STUDY.md sections 7.2 and 7.3.
+
+const LINKMODE_PREF = "gorilla.linkmode";
+
+// Level 1 "Satellite": study S2, S3, S10, S12 (prefs part).
+const SATELLITE = {
+  "media.autoplay.default": 5, // S2: no autoplay, muted video included
+  "media.preload.default": 1, // S3: no media preload (Firefox's own cellular value)
+  "media.preload.auto": 2, // S3: metadata only
+  "network.http.connection-timeout": 30, // S10
+  "network.http.tls-handshake-timeout": 60, // S10
+  "network.http.response.timeout": 300, // S10 / F6
+  "network.http.connection-retry-timeout": 1000, // S10: no backup connection before a 600 ms SYN-ACK
+  "network.dnsCacheExpiration": 600, // S12
+  "network.dnsCacheExpirationGracePeriod": 3600, // S12
+};
+
+// Level 2 "Very slow link": level 1 with GEO timeouts, plus S6, S7, S11.
+const VERY_SLOW = {
+  ...SATELLITE,
+  "network.http.connection-timeout": 60, // S10, GEO
+  "gfx.downloadable_fonts.enabled": false, // S6: no web fonts
+  "gorilla.network.save_data": true, // S7: "Save-Data: on" (nsHttpChannel::SetSaveData)
+  "network.http.max-persistent-connections-per-server": 6, // S11
+};
+
+const LEVELS = [{}, SATELLITE, VERY_SLOW];
+
+function getDefault(branch, name) {
+  switch (branch.getPrefType(name)) {
+    case Ci.nsIPrefBranch.PREF_INT:
+      return branch.getIntPref(name);
+    case Ci.nsIPrefBranch.PREF_BOOL:
+      return branch.getBoolPref(name);
+    case Ci.nsIPrefBranch.PREF_STRING:
+      return branch.getStringPref(name);
+  }
+  return undefined;
+}
+
+function setDefault(branch, name, value) {
+  if (typeof value === "boolean") {
+    branch.setBoolPref(name, value);
+  } else if (typeof value === "number") {
+    branch.setIntPref(name, value);
+  } else {
+    branch.setStringPref(name, String(value));
+  }
+}
+
+export const GorillaLinkMode = {
+  _shipped: null,
+  _applied: 0,
+
+  init() {
+    if (this._shipped) {
+      return;
+    }
+    const branch = Services.prefs.getDefaultBranch("");
+    this._shipped = {};
+    for (const name of Object.keys(VERY_SLOW)) {
+      this._shipped[name] = getDefault(branch, name);
+    }
+    Services.prefs.addObserver(LINKMODE_PREF, this);
+    this.apply();
+  },
+
+  observe() {
+    this.apply();
+  },
+
+  level() {
+    const n = Services.prefs.getIntPref(LINKMODE_PREF, 0);
+    return n >= 0 && n < LEVELS.length ? n : 0;
+  },
+
+  apply() {
+    const want = this.level();
+    if (want === this._applied) {
+      return;
+    }
+    const branch = Services.prefs.getDefaultBranch("");
+    const values = LEVELS[want];
+    for (const name of Object.keys(VERY_SLOW)) {
+      let value = name in values ? values[name] : this._shipped[name];
+      if (value === undefined) {
+        // Not defined in the shipped build and not part of this level.
+        if (name === "gorilla.network.save_data") {
+          value = false;
+        } else {
+          continue;
+        }
+      }
+      try {
+        setDefault(branch, name, value);
+      } catch (e) {
+        // A locked pref keeps its locked value.
+        console.error(`GorillaLinkMode: ${name}`, e);
+      }
+    }
+    this._applied = want;
+  },
+};
