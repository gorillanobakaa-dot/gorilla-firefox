+// GORILLA UNLEASHED - SATELLITE MODE: "Save-Data: on" asks the site for a
+// lighter page (only sites that honour it change anything). Off by default:
+// while on it is one more bit a site can see. No connection is made by it.
+void nsHttpChannel::SetSaveData() {
+  MOZ_ASSERT(NS_IsMainThread(), "Must be called on the main thread");
+
+  if (Preferences::GetBool("gorilla.network.save_data", false)) {
+    DebugOnly<nsresult> rv =
+        mRequestHead.SetHeader("Save-Data"_ns, "on"_ns, false);
+    MOZ_ASSERT(NS_SUCCEEDED(rv));
+  }
+}
