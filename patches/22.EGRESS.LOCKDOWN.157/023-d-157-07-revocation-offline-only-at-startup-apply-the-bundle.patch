+/**
+ * GORILLA UNLEASHED - PHYSICAL LOCK: offline OneCRL
+ * Decision D-157-07 (revocation offline only). Remote Settings never syncs in this build, so OneCRL records reached
+ * certificate storage only on a "sync" event that never came: the bundled dump was shipped but never applied.
+ * At startup, read the OneCRL dump packaged in the build (resource://app/defaults/settings/security-state/onecrl.json,
+ * no network) and hand it to updateCertBlocklist exactly as a sync event would: created / updated / deleted computed
+ * against the records stored last time. Then store the dump in the local collection, so the next start does nothing.
+ * Runs only when the stored collection is older than the dump, or when certificate storage has no revocation data
+ * at all (a new profile, or cert_storage re-created).
+ *
+ * @param {RemoteSettingsClient} client the "onecrl" client created in init()
+ */
+async function gorillaApplyBundledOneCRL(client) {
+  const dump = await lazy.SharedUtils.loadJSONDump(
+    SECURITY_STATE_BUCKET,
+    "onecrl"
+  );
+  if (!dump || !Array.isArray(dump.data) || !dump.timestamp) {
+    lazy.log.error("Gorilla offline OneCRL: no bundled dump in this build");
+    return;
+  }
+  let storedTimestamp = null;
+  try {
+    storedTimestamp = await client.db.getLastModified();
+  } catch (e) {
+    storedTimestamp = null;
+  }
+  const hasPriorRevocationData = await hasPriorData(
+    Ci.nsICertStorage.DATA_TYPE_REVOCATION
+  );
+  if (
+    hasPriorRevocationData &&
+    storedTimestamp &&
+    storedTimestamp >= dump.timestamp
+  ) {
+    return;
+  }
+  let previous = [];
+  try {
+    previous = await client.db.list();
+  } catch (e) {
+    previous = [];
+  }
+  const previousById = new Map(previous.map(r => [r.id, r]));
+  const currentIds = new Set(dump.data.map(r => r.id));
+  const created = [];
+  const updated = [];
+  for (const record of dump.data) {
+    const old = previousById.get(record.id);
+    if (!old) {
+      created.push(record);
+    } else if (old.last_modified != record.last_modified) {
+      updated.push({ old, new: record });
+    }
+  }
+  const deleted = previous.filter(r => !currentIds.has(r.id));
+  // updateCertBlocklist reloads everything itself when storage has no prior revocation data.
+  await updateCertBlocklist({
+    data: { current: dump.data, created, updated, deleted },
+  });
+  await client.db.importChanges(undefined, dump.timestamp, dump.data, {
+    clear: true,
+  });
+  lazy.log.info(
+    `Gorilla offline OneCRL: applied ${dump.data.length} bundled records (dump ${dump.timestamp})`
+  );
+}
