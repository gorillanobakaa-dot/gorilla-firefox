+++ b/toolkit/components/telemetry/moz.build
@@ -6,9 +6,8 @@ include("/ipc/chromium/chromium-config.mozbuild")
 
 FINAL_LIBRARY = "xul"
 
-DIRS = [
-    # GORILLA excised: "pingsender" (standalone telemetry sender; this browser sends no pings)
-]
+# GORILLA excised: DIRS = ["pingsender"] (standalone telemetry sender; this browser sends no pings).
+# mozbuild refuses an empty assignment, so the whole statement goes.
 
 DEFINES["MOZ_APP_VERSION"] = '"%s"' % CONFIG["MOZ_APP_VERSION"]
 
