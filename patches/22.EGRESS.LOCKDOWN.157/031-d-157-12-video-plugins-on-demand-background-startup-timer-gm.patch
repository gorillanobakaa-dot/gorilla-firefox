+  /**
+   * GORILLA UNLEASHED - PHYSICAL LOCK: video plugins on demand (D-157-12).
+   *
+   * Installs the given GMPs if they are missing, and only them: Widevine when a page asks for
+   * com.widevine.alpha and the CDM is not installed (GMPProvider, EMEVideo:CDMMissing), OpenH264
+   * when a page that holds the camera or microphone starts a peer connection (WebRTCParent).
+   * The manifest is the one built into the browser (LOCAL_GMP_SOURCES,
+   * chrome://global/content/gmp-sources/*.json): the file is fetched straight from the vendor
+   * URL written there (Google edgedl.me.gvt1.com with www.google.com as mirror, Cisco
+   * ciscobinary.openh264.org) and checked against the built-in sha512 and size before it is
+   * unpacked. Mozilla's update server and the Chromium update service are never asked.
+   *
+   * @param {string[]} ids GMP ids, e.g. ["gmp-widevinecdm"] or ["gmp-gmpopenh264"].
+   * @return a promise resolved with { status, results }.
+   */
+  async installOnDemand(ids) {
+    let log = getScopedLogger("GMPInstallManager.installOnDemand");
+    let wanted = getLocalSources().filter(
+      source =>
+        ids.includes(source.id) &&
+        !gOnDemandInFlight.has(source.id) &&
+        (source.installByDefault ||
+          GMPPrefs.getBool(GMPPrefs.KEY_PLUGIN_FORCE_INSTALL, false, source.id))
+    );
+    if (!wanted.length) {
+      return { status: "nothing-new-to-install" };
+    }
+    for (let source of wanted) {
+      gOnDemandInFlight.add(source.id);
+    }
+    try {
+      let { addons } = await downloadLocalConfig(wanted);
+      let results = [];
+      for (let config of addons) {
+        let gmpAddon = new GMPAddon(config);
+        if (
+          !gmpAddon.isValid ||
+          GMPUtils.isPluginHidden(gmpAddon) ||
+          gmpAddon.isInstalled ||
+          !this._isAddonEnabled(gmpAddon.id)
+        ) {
+          log.info("Not installing " + gmpAddon.toString());
+          continue;
+        }
+        log.info("Installing on demand: " + gmpAddon.toString());
+        try {
+          await this.installAddon(gmpAddon);
+          results.push({ id: gmpAddon.id, result: "succeeded" });
+        } catch (e) {
+          log.error("On-demand install of " + gmpAddon.id + " failed", e);
+          results.push({ id: gmpAddon.id, result: "failed" });
+        }
+      }
+      return { status: "done", results };
+    } finally {
+      for (let source of wanted) {
+        gOnDemandInFlight.delete(source.id);
+      }
+    }
+  },
+
   /**
    * Makes sure everything is cleaned up
    */
