# Gorilla 158 rebase: browser/branding/gorilla/branding.nsi as built on Firefox 158
# The earlier patches of this file do not apply to pristine 158 (superseded in the policy with
# exclude_reason_158); this patch carries the file from the remaining set to the built tree.

diff --git a/browser/branding/gorilla/branding.nsi b/browser/branding/gorilla/branding.nsi
index bfa8395c3ffc9f90fadaa6d4f46ca03be9c46f45..a425791609c16379ad60ad9c65dd27eae9ce24bb 100644
--- a/browser/branding/gorilla/branding.nsi
+++ b/browser/branding/gorilla/branding.nsi
@@ -40,7 +40,9 @@
 # only because installer.nsi references them unconditionally; the full
 # installer never downloads anything, so they are inert.
 # The installer's certificate name and issuer expected by the stub installer
-!define CertNameDownload   "Mozilla Corporation"
+# GORILLA 157: only stub.nsh reads this (not built). Not Mozilla's name: a stub expecting this signer refuses
+# every download, because Gorilla builds are unsigned (fail closed).
+!define CertNameDownload   "Gorilla Unleashed"
 !define CertIssuerDownload "DigiCert Trusted G4 Code Signing RSA4096 SHA384 2021 CA1"
 
 # Dialog units are used so the UI displays correctly with the system's DPI
