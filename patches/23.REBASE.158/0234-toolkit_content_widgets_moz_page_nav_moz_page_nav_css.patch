# exclude_reason_158); this patch carries the file from the remaining set to the built tree.

diff --git a/toolkit/content/widgets/moz-page-nav/moz-page-nav.css b/toolkit/content/widgets/moz-page-nav/moz-page-nav.css
index bb9a418a152ca4477529466e93086c9b9d5502b6..9fa58a4ff7288bfb283a3e5aaf7b64e4a61c945c 100644
