# Gorilla 158 rebase: toolkit/components/search/SearchService.sys.mjs as built on Firefox 158
# The earlier patches of this file do not apply to pristine 158 (superseded in the policy with
# exclude_reason_158); this patch carries the file from the remaining set to the built tree.

diff --git a/toolkit/components/search/SearchService.sys.mjs b/toolkit/components/search/SearchService.sys.mjs
index 8ddfded38ba47134cc13b31af9b31e61104b2ff3..bd9ce5a24cd93d30001fd5a087e4c43bfadc2607 100644
--- a/toolkit/components/search/SearchService.sys.mjs
+++ b/toolkit/components/search/SearchService.sys.mjs
@@ -2609,7 +2609,11 @@ export const SearchService = new (class SearchService {
   #addEngineToStore(engine, skipDuplicateCheck = false) {
     // GORILLA UNLEASHED - PHYSICAL LOCK: one search engine. Google (the built-in configuration, D-158-13) is the only search engine; no engine is added from a site, a form, a policy or by hand (owner 2026-10-15: "we do not trust sites that offer functions like this"). Every add, and every
     // engine an earlier profile saved, passes here: only the application's own engines are stored.
-    if (!(engine instanceof lazy.AppProvidedConfigEngine)) {
+    // 2026-10-18: "app-provided" was not enough. A profile carried over from 157 still listed Perplexity, Bing,
+    // DuckDuckGo, Wikipedia and eBay as configuration engines, and they came back from the profile's own stored
+    // configuration although the built-in one holds Google alone. Only the Google engine itself is stored, by
+    // identifier, whatever configuration source offers the others.
+    if (!(engine instanceof lazy.AppProvidedConfigEngine) || !/^google(-|$)/.test(engine.id || "")) {
       lazy.logConsole.warn("[GORILLA] search engine refused (Google only):", engine.name);
       return;
     }
