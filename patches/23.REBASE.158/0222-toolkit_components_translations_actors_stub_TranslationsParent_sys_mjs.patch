diff --git a/toolkit/components/translations/actors/stub/TranslationsParent.sys.mjs b/toolkit/components/translations/actors/stub/TranslationsParent.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0ca0616249c7ca5252a6408d8d55820f3cf49d26
