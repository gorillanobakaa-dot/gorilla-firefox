# Gorilla 157 port fix
# Fluent parse fix (2026-10-08): an 08.Look port step had put the plural select of ip-protection-site-exceptions-all-sites-button .description on one line (Fluent error E0003), so Firefox dropped the whole entry and the button lost its label. The select is back on separate lines as in pristine 157; the Gorilla wording of .label stays (D-157-34). Found by the new Fluent check in build-harness verify.
# Files: browser/locales/en-US/browser/ipProtection.ftl

diff --git a/browser/locales/en-US/browser/ipProtection.ftl b/browser/locales/en-US/browser/ipProtection.ftl
index 959c00e6e4..4f8d82752b 100644
--- a/browser/locales/en-US/browser/ipProtection.ftl
+++ b/browser/locales/en-US/browser/ipProtection.ftl
@@ -291,7 +291,11 @@ ip-protection-not-opted-in-button = Get started
 #   $count (number) - The number of sites saved as VPN exclusions.
 ip-protection-site-exceptions-all-sites-button =
   .label = Manage website Gorilla settings
-  .description = { $count -> [one] { $count } website *[other] { $count } websites }
+  .description =
+    { $count ->
+        [one] { $count } website
+       *[other] { $count } websites
+    }
 
 ip-protection-site-rules-header =
   .heading = Manage website rules
