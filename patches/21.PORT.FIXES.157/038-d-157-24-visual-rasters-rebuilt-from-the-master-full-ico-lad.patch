# Gorilla 157 port fix
# D-157-24 visual: rasters rebuilt from the master, full .ico ladders, About logo image-set, clamp, Gorilla wordmark
# Files: browser/base/content/aboutDialog.css, browser/branding/gorilla/branding.nsi, browser/branding/gorilla/content/about-logo-private.png, browser/branding/gorilla/content/about-logo-private@2x.png, browser/branding/gorilla/content/aboutDialog.css, browser/branding/gorilla/content/firefox-wordmark.svg, browser/branding/gorilla/content/icon128.png, browser/branding/gorilla/content/icon16.png, browser/branding/gorilla/content/icon32.png, browser/branding/gorilla/content/icon48.png, browser/branding/gorilla/content/icon64.png, browser/branding/gorilla/document_pdf.ico, browser/branding/gorilla/newtab.ico, browser/branding/gorilla/newwindow.ico, browser/themes/shared/browser-shared.css, browser/themes/shared/master-redirect.css, browser/themes/shared/preferences/preferences.css

diff --git a/browser/base/content/aboutDialog.css b/browser/base/content/aboutDialog.css
index 97aab3e124..4e953a4c51 100644
--- a/browser/base/content/aboutDialog.css
+++ b/browser/base/content/aboutDialog.css
@@ -21,7 +21,8 @@
 }
 
 #leftBox {
-  background-image: url("chrome://branding/content/about-logo.png") !important;
+  /* GORILLA 157 (D-157-24): 1x + 2x candidates, so the logo stays crisp at 200% scaling. */
+  background-image: image-set(url("chrome://branding/content/about-logo.png") 1x, url("chrome://branding/content/about-logo@2x.png") 2x) !important;
   background-repeat: no-repeat !important;
   background-size: 500px 500px !important;
   background-position: center !important;
diff --git a/browser/branding/gorilla/branding.nsi b/browser/branding/gorilla/branding.nsi
index bfa8395c3f..a425791609 100644
--- a/browser/branding/gorilla/branding.nsi
+++ b/browser/branding/gorilla/branding.nsi
@@ -40,7 +40,9 @@
 # only because installer.nsi references them unconditionally; the full
 # installer never downloads anything, so they are inert.
 # The installer's certificate name and issuer expected by the stub installer
-!define CertNameDownload   "Mozilla Corporation"
+# GORILLA 157: only stub.nsh reads this (not built). Not Mozilla's name: a stub expecting this signer refuses
+# every download, because Gorilla builds are unsigned (fail closed).
+!define CertNameDownload   "Gorilla Unleashed"
 !define CertIssuerDownload "DigiCert Trusted G4 Code Signing RSA4096 SHA384 2021 CA1"
 
 # Dialog units are used so the UI displays correctly with the system's DPI
diff --git a/browser/branding/gorilla/content/about-logo-private.png b/browser/branding/gorilla/content/about-logo-private.png
index d614b3ad0e4e988755147e37df20bcd0a4165dea..6e4b33504cd41bed8ffbd94d849863500542246b 100644
