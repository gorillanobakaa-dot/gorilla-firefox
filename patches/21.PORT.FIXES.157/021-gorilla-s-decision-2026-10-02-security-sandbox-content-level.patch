# Gorilla 157 port fix
# Gorilla's decision 2026-10-02: security.sandbox.content.level 4 is the Linux value; on Windows Mozilla's 9 (its strictest) applies. The all.js line is now under #ifdef XP_LINUX.
# Files: modules/libpref/init/all.js

diff --git a/modules/libpref/init/all.js b/modules/libpref/init/all.js
index 845a0c8c4e..604409922b 100644
--- a/modules/libpref/init/all.js
+++ b/modules/libpref/init/all.js
@@ -4296,7 +4296,11 @@ pref("gfx.blacklist.all", 0);
 pref("gfx.blacklist.suggested-driver-version", "0.0.0.0");
 
 // --- Sandbox & Performance Overrides ---
+// Content-process sandbox level 4 is the strict setting on Linux. Windows uses a different, longer scale: Mozilla
+// ships 9 there (its strictest, set in browser/app/profile/firefox.js), so the Linux value must not apply on Windows.
+#ifdef XP_LINUX
 pref("security.sandbox.content.level", 4);
+#endif
 pref("javascript.options.mem.max", 1024);
 
 // --- Bundled Font Preferences ---
