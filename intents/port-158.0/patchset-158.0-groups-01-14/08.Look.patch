diff --git a/browser/branding/gorilla/content/aboutDialog.css b/browser/branding/gorilla/content/aboutDialog.css
new file mode 100644
index 0000000000..97aab3e124
--- /dev/null
+++ b/browser/branding/gorilla/content/aboutDialog.css
@@ -0,0 +1,71 @@
+#aboutDialogContainer {
+  background-color: #20123a !important;
+  color: #fff !important;
+  display: flex !important;
+  flex-direction: column !important;
+  align-items: center !important;
+  justify-content: center !important; /* Center content vertically */
+  min-height: 800px !important;
+  position: relative !important;
+  padding: 0 !important;
+}
+
+/* Re-insert the massive Gorilla icon in the center */
+#clientBox {
+  display: flex !important;
+  flex-direction: column !important;
+  align-items: center !important;
+  justify-content: center !important;
+  width: 100% !important;
+  flex: 1 !important;
+}
+
+#leftBox {
+  background-image: url("chrome://branding/content/about-logo.png") !important;
+  background-repeat: no-repeat !important;
+  background-size: 500px 500px !important;
+  background-position: center !important;
+  width: 500px !important;
+  height: 500px !important;
+  margin: 0 auto !important;
+  flex: none !important;
+  display: block !important;
+}
+
+/* Keep wordmark in top right but ensure it doesn't break flow */
+#aboutDialogContainer::before {
+  content: "" !important;
+  display: block !important;
+  position: absolute !important;
+  top: 20px !important;
+  right: 20px !important;
+  width: 250px !important;
+  height: 80px !important;
+  background-image: url("chrome://branding/content/about-wordmark.svg") !important;
+  background-repeat: no-repeat !important;
+  background-size: contain !important;
+  background-position: right top !important;
+  z-index: 100 !important;
+}
+
+#rightBox {
+  background-image: none !important;
+  width: 100% !important;
+  margin: 0 !important;
+  padding: 0 !important;
+  display: flex !important;
+  flex-direction: column !important;
+  align-items: center !important;
+}
+
+#detailsBox {
+  text-align: center !important;
+  margin-top: 20px !important;
+}
+
+#bottomBox {
+  background-color: hsla(235, 43%, 10%, 0.5) !important;
+  width: 100% !important;
+  padding: 15px !important;
+  text-align: center !important;
+}
