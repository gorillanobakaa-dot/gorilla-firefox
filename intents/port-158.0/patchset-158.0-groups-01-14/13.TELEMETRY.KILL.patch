index af686be595..abec595865 100644
--- a/third_party/rust/glean-core/src/dispatcher/global.rs
+++ b/third_party/rust/glean-core/src/dispatcher/global.rs
@@ -45,6 +45,17 @@ fn guard() -> DispatchGuard {
 ///
 /// [`flush_init`]: fn.flush_init.html
 pub fn launch(task: impl FnOnce() + Send + 'static) {
+    // Gorilla: telemetry is disabled at the FOG layer (FOG::InitializeFOG is a
+    // no-op), so the dispatcher is never flushed. Metric-recording tasks would
+    // otherwise pile up in the pre-init buffer forever — costing ~0.84% parent
+    // CPU on the calling threads (Renderer/Compositor/WebRender/Socket) and
+    // slowly leaking memory holding closures. Drop them immediately in
+    // production. Test mode keeps full behavior so vendored tests still pass.
+    if !TESTING_MODE.load(Ordering::SeqCst) {
+        drop(task);
+        return;
+    }
+
     let current_thread = thread::current();
     if let Some("glean.shutdown") = current_thread.name() {
         log::error!("Tried to launch a task from the shutdown thread. That is forbidden.");
diff --git a/third_party/rust/glean-core/src/lib.rs b/third_party/rust/glean-core/src/lib.rs
index 9c2cce6cd5..9806d8af3e 100644
--- a/third_party/rust/glean-core/src/lib.rs
+++ b/third_party/rust/glean-core/src/lib.rs
@@ -105,6 +105,16 @@ pub(crate) const DELETION_REQUEST_PINGS_DIRECTORY: &str = "deletion_request";
 /// Note: The initialization might still be in progress, as it runs in a separate thread.
 static INITIALIZE_CALLED: AtomicBool = AtomicBool::new(false);
 
+/// Gorilla: compile-time telemetry kill switch.
+///
+/// This build never calls `glean::initialize()` (FOG::InitializeFOG is a no-op),
+/// so no metric will ever be uploaded. Guarding the hot metric-recording paths
+/// with this `const` (rather than a runtime flag) lets the optimizer dead-code-
+/// eliminate the guarded bodies entirely — no atomic load, no branch, and under
+/// LTO the eliminated bodies let callers (e.g. WebRender frame timings) drop the
+/// calls too. Set to `false` to restore stock Glean recording behavior.
+pub const GORILLA_TELEMETRY_OFF: bool = true;
+
 /// Keep track of the debug features before Glean is initialized.
 static PRE_INIT_DEBUG_VIEW_TAG: Mutex<String> = Mutex::new(String::new());
 static PRE_INIT_LOG_PINGS: AtomicBool = AtomicBool::new(false);
